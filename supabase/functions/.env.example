# OpenWA server-side secrets. Configure these in Supabase Edge Function Secrets.
OPENWA_BASE_URL=https://whatsapp.example.com/api
OPENWA_API_KEY=owa_replace_me
OPENWA_SESSION_ID=00000000-0000-0000-0000-000000000000
OPENWA_DEFAULT_COUNTRY_CODE=53
WA_NOTIFY_SECRET=replace_with_a_long_random_secret

# Destination after accepting an organization invitation. It must also be in
# Supabase Authentication > URL Configuration > Redirect URLs.
INVITE_REDIRECT_URL=http://localhost:3000/auth/callback
